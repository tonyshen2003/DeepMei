建设 “树莓派”全国性社团的构想，推动树莓派在苏州地区的发展建设。在新冠疫情期间，联合其他社团和学校，发起了树莓派援助武汉的募捐活动。","身份证出生地":"江苏省苏州市市辖区","身份证号":"320501200306066753","身份证年龄":[{"text":"23","type":"text"}],"身份证校验":[{"text":"✔","type":"text"}]},"id":"recuqCz14oZ5w7","record_id":"recuqCz14oZ5w7"}],"page_token":"recuqCz14oZ5w7","total":580},"msg":"success"}